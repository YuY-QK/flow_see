{
  "title": "课程目录 curriculum/<学科>/grade<年级>.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "description": "学期：1 = 上册，2 = 下册",
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "domain": {
            "description": "学科领域 id，须在 curriculum/grades.yaml 中对应学科的 domains 列表中",
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "description": "知识点文件还没写时，卡片上显示的名称"
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "lessons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "subject",
    "grade",
    "units"
  ],
  "additionalProperties": false
}
