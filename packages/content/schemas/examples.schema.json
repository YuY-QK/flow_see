{
  "title": "创作示例目录 examples/index.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "分类，显示顺序同这里"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "来源：第一版只有官方；以后社区投稿入选精选后显示作者名"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "示例作品的署名"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": "示例的显示顺序，对应 examples/<id>.yaml"
    }
  },
  "required": [
    "categories",
    "source",
    "author",
    "items"
  ],
  "additionalProperties": false
}
