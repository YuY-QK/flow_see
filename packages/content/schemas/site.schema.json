{
  "title": "站点公共配置 site.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "site": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "default": "动画学堂",
          "description": "网站名称：顶部栏、侧边栏、网页标题、设置·关于",
          "type": "string",
          "minLength": 1
        },
        "slogan": {
          "default": "看动画，动手试，弄明白为什么",
          "type": "string"
        },
        "logo": {
          "default": "assets/brand/logo.svg",
          "description": "相对 packages/content 的路径",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "description": "全部留空 → 帮助页隐藏反馈区",
      "default": {},
      "type": "object",
      "properties": {
        "email": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          ]
        },
        "wechat": {
          "default": "",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "description": "第一次打开时的默认值；用户改过后以本机设置为准",
      "default": {},
      "type": "object",
      "properties": {
        "grade": {
          "default": 1,
          "description": "第一次打开时的年级，须在 curriculum/grades.yaml 中",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "subject": {
          "default": "math",
          "type": "string"
        },
        "uiTheme": {
          "default": "light",
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ]
        },
        "animTheme": {
          "default": "cute",
          "type": "string",
          "enum": [
            "flat",
            "cute",
            "chalk",
            "pro"
          ]
        },
        "fontSize": {
          "default": "normal",
          "type": "string",
          "enum": [
            "normal",
            "large"
          ]
        },
        "narrate": {
          "default": true,
          "description": "自动朗读",
          "type": "boolean"
        },
        "speechRate": {
          "default": "normal",
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "speed": {
          "default": 1,
          "anyOf": [
            {
              "type": "number",
              "const": 0.5
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 1.5
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "autoplayOnFirstOpen": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "learning": {
      "default": {},
      "type": "object",
      "properties": {
        "recordLimit": {
          "default": 200,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "continueCount": {
          "default": {},
          "type": "object",
          "properties": {
            "desktop": {
              "default": 3,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pad": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "phone": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "recommendedLimit": {
          "default": 4,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prevNextCrossGrade": {
          "default": false,
          "type": "boolean"
        },
        "prevNextCrossSubject": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "search": {
      "default": {},
      "type": "object",
      "properties": {
        "hints": {
          "default": [
            "分数",
            "钟表",
            "凑十",
            "植物",
            "水"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxResults": {
          "default": 50,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "share": {
      "default": {},
      "type": "object",
      "properties": {
        "apiBase": {
          "default": "/api",
          "description": "分享接口地址；换到自己的服务器时只改这里",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "help": {
      "default": {},
      "type": "object",
      "properties": {
        "faq": {
          "default": "help.yaml",
          "description": "常见问题文件，相对 packages/content",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
